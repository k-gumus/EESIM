{
  "name": "eesim",
  "private": true,
  "version": "0.3.0",
  "description": "EESIM — Tepecan ile web tabanlı, 3D destekli, yapay zekâ destekli devre laboratuvarı",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "dev:api": "wrangler dev",
    "db:local": "wrangler d1 execute eesim --local --file=schema.sql",
    "db:remote": "wrangler d1 execute eesim --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87",
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "@xyflow/react": "^12.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.4",
    "wrangler": "4.152.0"
  }
}
