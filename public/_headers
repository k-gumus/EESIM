# Cloudflare, bu dosyadaki başlıkları statik varlıklara (dist/) uygular.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Content-Security-Policy UYGULANIYOR: sayfa yalnızca kendi dosyalarını, Cloudflare Web Analytics'i ve
# WebLLM model indirmelerini (Hugging Face, raw.githubusercontent) yükleyebilir. Yeni bir dış kaynak (CDN, font,
# analiz aracı) eklersen buraya da yazmalısın; yoksa tarayıcı onu engeller (konsolda "Refused to load" görünür).
# Ollama'yı localhost dışında bir adresten kullanıyorsan o adresi connect-src'ye ekle.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://huggingface.co https://*.hf.co https://cdn-lfs.huggingface.co https://raw.githubusercontent.com http://localhost:11434; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# API yanıtları zaten kod tarafında "no-store" gönderiyor; burada statik varlıklar hedeflenir.
